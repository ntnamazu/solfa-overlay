{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2022"],
    "types": ["node"]
  },
  "include": [
    "src/main/**/*",
    "src/preload/**/*",
    "src/domain/**/*",
    "src/storage/**/*",
    "src/shared/**/*",
    "tests/unit/**/*",
    "tests/integration/**/*",
    "scripts/**/*.ts",
    "electron.vite.config.ts",
    "vitest.config.ts"
  ],
  // 画面コンポーネントのテストは jsx 設定を持つ tsconfig.web.json 側で型検査する
  "exclude": ["tests/unit/renderer/**/*"]
}
